modules = ["python-3.11", "nodejs-24", "dart-3.10"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DENTAPRO Flutter Preview"

[[workflows.workflow]]
name = "DENTAPRO Flutter Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd mobile && flutter run -d web-server --web-hostname 0.0.0.0 --web-port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["flutter"]
