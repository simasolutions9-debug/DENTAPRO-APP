# Django
SECRET_KEY=
# Set DEBUG=True only for local testing; patient registration is disabled otherwise.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
DENTAPRO_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# PostgreSQL 16
POSTGRES_DB=dentapro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Least-privilege application role; used by both the database initializer and Django.
APP_DB_USER=dentapro_app
APP_DB_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379/0
